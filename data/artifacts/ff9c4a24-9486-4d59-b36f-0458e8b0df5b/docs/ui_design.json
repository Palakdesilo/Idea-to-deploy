{
    "design_tokens": {
        "colors": {
            "primary": "#2563EB",
            "primary_hover": "#1D4ED8",
            "secondary": "#64748B",
            "success": "#10B981",
            "error": "#EF4444",
            "warning": "#F59E0B",
            "background": "#FFFFFF",
            "surface": "#F8FAFC",
            "border": "#E2E8F0",
            "text_primary": "#0F172A",
            "text_secondary": "#64748B",
            "text_muted": "#94A3B8"
        },
        "typography": {
            "font_family": "Inter, system-ui, sans-serif",
            "h1": {
                "size": "32px",
                "weight": "700",
                "line_height": "40px"
            },
            "h2": {
                "size": "24px",
                "weight": "600",
                "line_height": "32px"
            },
            "h3": {
                "size": "20px",
                "weight": "600",
                "line_height": "28px"
            },
            "h4": {
                "size": "18px",
                "weight": "600",
                "line_height": "24px"
            },
            "body": {
                "size": "16px",
                "weight": "400",
                "line_height": "24px"
            },
            "small": {
                "size": "14px",
                "weight": "400",
                "line_height": "20px"
            },
            "caption": {
                "size": "12px",
                "weight": "400",
                "line_height": "16px"
            }
        },
        "spacing": {
            "xs": "4px",
            "sm": "8px",
            "md": "16px",
            "lg": "24px",
            "xl": "32px",
            "2xl": "48px",
            "3xl": "64px"
        },
        "radius": {
            "sm": "4px",
            "md": "8px",
            "lg": "12px",
            "full": "9999px"
        },
        "shadows": {
            "sm": "0 1px 2px rgba(0,0,0,0.05)",
            "md": "0 4px 6px rgba(0,0,0,0.1)",
            "lg": "0 10px 15px rgba(0,0,0,0.1)"
        }
    },
    "component_styles": {
        "Button": {
            "primary": {
                "background": "$colors.primary",
                "color": "#FFFFFF",
                "padding": "$spacing.sm $spacing.md",
                "border_radius": "$radius.md",
                "font_weight": "600",
                "hover": {
                    "background": "$colors.primary_hover"
                }
            },
            "secondary": {
                "background": "$colors.surface",
                "color": "$colors.text_primary",
                "border": "1px solid $colors.border",
                "padding": "$spacing.sm $spacing.md",
                "border_radius": "$radius.md",
                "font_weight": "600"
            }
        },
        "Input": {
            "default": {
                "border": "1px solid $colors.border",
                "padding": "$spacing.sm $spacing.md",
                "border_radius": "$radius.md",
                "background": "$colors.background",
                "font_size": "$typography.body.size"
            }
        },
        "Card": {
            "default": {
                "background": "$colors.background",
                "border": "1px solid $colors.border",
                "border_radius": "$radius.lg",
                "padding": "$spacing.lg",
                "shadow": "$shadows.sm"
            }
        },
        "Header": {
            "default": {
                "background": "$colors.background",
                "border_bottom": "1px solid $colors.border",
                "padding": "$spacing.md $spacing.xl",
                "height": "64px"
            }
        },
        "Sidebar": {
            "default": {
                "background": "$colors.surface",
                "border_right": "1px solid $colors.border",
                "width": "256px",
                "padding": "$spacing.lg"
            }
        },
        "Table": {
            "default": {
                "border": "1px solid $colors.border",
                "border_radius": "$radius.lg",
                "header_background": "$colors.surface",
                "row_hover": "$colors.surface"
            }
        }
    },
    "screens": [
        {
            "screen": "Landing Page / Home Screen",
            "layout": [
                {
                    "section": "Header",
                    "style": {
                        "background": "$colors.background",
                        "border_bottom": "1px solid $colors.border",
                        "padding": "$spacing.md $spacing.xl"
                    },
                    "components": [
                        {
                            "name": "Global Header (Logo, Search, Nav, Account, Cart)",
                            "variant": "Header.default",
                            "elements": {
                                "logo": {
                                    "height": "32px"
                                },
                                "search": {
                                    "component": "Input.default",
                                    "width": "400px"
                                },
                                "nav_links": {
                                    "color": "$colors.text_primary",
                                    "spacing": "$spacing.lg"
                                },
                                "icons": {
                                    "size": "24px",
                                    "color": "$colors.text_secondary"
                                }
                            }
                        }
                    ]
                },
                {
                    "section": "Hero Area",
                    "style": {
                        "padding": "$spacing.3xl 0",
                        "background": "$colors.surface"
                    },
                    "components": [
                        {
                            "name": "Hero Carousel",
                            "variant": "Card.default",
                            "height": "480px",
                            "border_radius": "$radius.lg"
                        }
                    ]
                },
                {
                    "section": "Promotional Section",
                    "style": {
                        "padding": "$spacing.2xl 0"
                    },
                    "components": [
                        {
                            "name": "Promotional Banners",
                            "variant": "Card.default",
                            "layout": "grid",
                            "gap": "$spacing.lg"
                        }
                    ]
                },
                {
                    "section": "Featured Products",
                    "style": {
                        "padding": "$spacing.2xl 0"
                    },
                    "components": [
                        {
                            "name": "Featured Products Grid",
                            "layout": "grid",
                            "columns": "4",
                            "gap": "$spacing.lg",
                            "item": {
                                "variant": "Card.default",
                                "image_height": "240px",
                                "padding": "$spacing.md"
                            }
                        }
                    ]
                },
                {
                    "section": "Footer",
                    "style": {
                        "background": "$colors.surface",
                        "border_top": "1px solid $colors.border",
                        "padding": "$spacing.2xl $spacing.xl"
                    },
                    "components": [
                        {
                            "name": "Global Footer",
                            "color": "$colors.text_secondary",
                            "font_size": "$typography.small.size"
                        }
                    ]
                }
            ]
        },
        {
            "screen": "Product Catalog / Search Results Screen",
            "layout": [
                {
                    "section": "Header",
                    "style": {
                        "variant": "Header.default"
                    },
