{
  "wireframes": [
    {
      "screen": "Landing Page",
      "screenKey": "landingpage",
      "route": "/landingpage",
      "shellType": "Internal",
      "purpose": "Welcome screen",
      "layout": [
        {
          "section": "Hero",
          "layoutType": "heroSplit",
          "components": [
            {
              "key": "H1",
              "type": "Hero",
              "label": "Full-stack e-commerce platform that allows users to register, browse products, manage a shopping cart, place orders, make payments, track order status, and manage returns, with an admin dashboard for product, inventory, and order management.\n\n",
              "content": "Discover the most advanced management. experience ever built.",
              "subtext": "Shop Now"
            }
          ]
        },
        {
          "section": "Stats",
          "layoutType": "grid",
          "components": [
            {
              "key": "S1",
              "type": "StatCard",
              "label": "Happy Customers",
              "content": "1.2M+",
              "subtext": "Verified reviews"
            },
            {
              "key": "S2",
              "type": "StatCard",
              "label": "Global Shipping",
              "content": "24h",
              "subtext": "Average delivery time"
            },
            {
              "key": "S3",
              "type": "StatCard",
              "label": "Secure Payments",
              "content": "100%",
              "subtext": "Encrypted transactions"
            }
          ]
        },
        {
          "section": "Features",
          "layoutType": "masonryGrid",
          "components": [
            {
              "key": "F1",
              "type": "FeatureGrid",
              "label": "Curated Selection",
              "content": "Only the finest products selected by experts."
            },
            {
              "key": "F2",
              "type": "FeatureGrid",
              "label": "Fast Logistics",
              "content": "Next-day delivery available worldwide."
            },
            {
              "key": "F3",
              "type": "FeatureGrid",
              "label": "Easy Returns",
              "content": "30-day no-questions-asked return policy."
            }
          ]
        }
      ],
      "primary_action": "Proceed",
      "flow": "Standard flow"
    },
    {
      "screen": "Login",
      "screenKey": "login",
      "route": "/login",
      "shellType": "Internal",
      "purpose": "Access account",
      "layout": [
        {
          "section": "AuthShell",
          "layoutType": "authShell",
          "components": [
            {
              "key": "Auth",
              "type": "AuthCard",
              "label": "Login",
              "annotation": "Secure Login"
            }
          ]
        }
      ],
      "primary_action": "Proceed",
      "flow": "Standard flow"
    },
